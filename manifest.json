{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "تبيان (Tibyan)",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "تبيان | للتحقق من صحة الحديث"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://dorar.net/*",
    "https://*.hirenodes.com/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/text-cleaner.js",
        "src/utils/offline-dataset.js",
        "src/utils/verifier-engine.js",
        "src/utils/card-generator.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
